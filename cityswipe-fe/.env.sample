# Required: Clerk keys from the same application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required for signed-in data storage
DATABASE_URL=
# Optional direct database URL for Prisma schema commands
DIRECT_URL=

# Required for suggestions and chat
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=models/gemini-flash-latest

# Optional: photos (bundled fallback when unset)
PEXELS_API_KEY=

# Optional: billing
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_M_PLAN=
STRIPE_Y_PLAN=

# Optional: flight and hotel search
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
RAPID_API_KEY=

# Optional GIF search
GIPHY_API_KEY=
